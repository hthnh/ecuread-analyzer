+        evidence['anomaly_timeline']={'status':'available','analysis_run_id':evidence['analysis_run_id'],'items':[
+            {'start_sequence':end.seq,'end_sequence':end.seq,'start_time_ms':end.timestamp_ms,'end_time_ms':end.timestamp_ms}]}
+        original=deepcopy(evidence);_store_analysis_success(ride,evidence);db.session.commit()
+        snapshot=analysis_snapshot(ride)
