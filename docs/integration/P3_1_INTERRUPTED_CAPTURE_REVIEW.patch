+
+    def test_interrupted_unknown_reason_retains_termination_state(self):
+        ride,_=self.interrupted('p31-unknown-reason');ride.termination_reason=None
+        summary=capture_termination_summary(ride)
+        self.assertEqual(summary['state'],'interrupted');self.assertEqual(summary['reason'],'Unknown')
