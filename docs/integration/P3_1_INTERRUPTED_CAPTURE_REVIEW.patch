+        from services.analysis import diagnostic_evidence_view
+        self.assertEqual(diagnostic_evidence_view(evidence)['summary']['possible_causes'],[])
+        self.assertEqual(evidence['health_score'],original['health_score'])
+        page=self.c.client.get(f'/sessions/{ride.id}').get_data(as_text=True)
+        self.assertIn('evidence-event-link',page);self.assertIn('capture-termination-context',page)
