+"""Terminal capture eligibility, historical preservation and causal restraint."""
+from copy import deepcopy
+from pathlib import Path
+import json
+import unittest
+from unittest.mock import patch
+
+from extensions import db
+from integrations.analyzer_client import AnalyzerClient, AnalyzerClientError
+from models import AnalysisResult, RideSession
+from services.analysis import analysis_snapshot, capture_termination_summary, session_records
+from services.analysis_submission import _raw_decode_request, _store_analysis_success, manual_rerun_state, submit_session_to_analyzer
+from tests import test_app as fixtures
+from tests.test_p3_rerun_recovery import Actions
+from tests.test_localization import Text
+
+
+class InterruptedCaptureTests(unittest.TestCase):
+    def setUp(self):
+        self.c = fixtures.DashboardTestCase('runTest')
+        self.c.setUp()
+        self.addCleanup(self.c.tearDown)
+        self.c.app.config['ML_API_BASE_URL'] = 'http://analyzer.example'
+        self.c.login()
+
+    def interrupted(self, name):
+        payload = self.c.pi_payload(session_id=name, seqs=tuple(range(10)), ended=True,
+                                    capture_status='interrupted', termination_reason='unclean_runtime_shutdown',
+                                    analysis=self.c.pi_analysis(run_id='pi-'+name))
+        response = self.c.client.post('/api/device/sync/session', json=payload, headers=self.c.headers_a)
+        self.assertEqual(response.status_code, 200)
+        return RideSession.query.filter_by(session_id=name).one(), payload
+
+    def test_completed_and_interrupted_sync_and_input_contract_match_page_api_and_service(self):
+        ride, _ = self.interrupted('p31-state-matrix')
+        for capture, sync, eligible in [('completed','complete',True), ('interrupted','complete',True),
+                                         ('interrupted','partial',False), ('interrupted','syncing',False),
+                                         ('capturing','complete',False), ('failed','complete',False)]:
+            with self.subTest(capture=capture, sync=sync):
+                ride.capture_status=capture;ride.sync_status=sync;db.session.commit()
+                state=manual_rerun_state(ride,session_records(ride))
+                self.assertEqual(state['eligible'],eligible)
+                html=self.c.client.get(f'/sessions/{ride.id}').get_data(as_text=True)
+                parser=Actions();parser.feed(html);self.assertEqual(bool(parser.buttons),eligible)
+                if not eligible:
+                    before=(ride.analysis_status,ride.analysis_run_id,ride.updated_at)
+                    with patch.object(AnalyzerClient,'decode_analyze_raw_session') as raw, patch.object(AnalyzerClient,'analyze_session') as canonical:
+                        response=self.c.client.post(f'/api/sessions/{ride.id}/analysis/re-run',json={'request_id':'ineligible'})
+                        self.assertEqual(response.status_code,409)
+                        self.assertEqual(submit_session_to_analyzer(ride.id,force=True)['state'],'ineligible')
+                        raw.assert_not_called();canonical.assert_not_called()
+                    self.assertEqual((ride.analysis_status,ride.analysis_run_id,ride.updated_at),before)
+
+    def test_interrupted_invalid_raw_missing_and_unreconstructible_input_never_submit(self):
+        for defect in ['bad_hex','missing_canonical','missing_records']:
+            with self.subTest(defect=defect):
+                ride,_=self.interrupted('p31-'+defect)
+                record=ride.telemetry_records[0]
+                if defect=='bad_hex':record.raw_hex='NOT-HEX'
+                elif defect=='missing_canonical':record.raw_hex=None;record.raw_frame=None;record.iat_c=None
+                else:db.session.delete(record)
+                db.session.commit()
+                with patch.object(AnalyzerClient,'decode_analyze_raw_session') as raw, patch.object(AnalyzerClient,'analyze_session') as canonical:
+                    self.assertEqual(self.c.client.post(f'/api/sessions/{ride.id}/analysis/re-run',json={'request_id':'invalid'}).status_code,409)
+                    self.assertEqual(submit_session_to_analyzer(ride.id,force=True)['state'],'ineligible')
+                    raw.assert_not_called();canonical.assert_not_called()
+                self.assertEqual(ride.capture_status,'interrupted')
+
+    def test_real_manual_route_retry_preserves_upload_identity_and_all_history(self):
+        ride,payload=self.interrupted('p31-preserved')
+        original_run=ride.analysis_run_id
+        original=deepcopy(AnalysisResult.query.filter_by(analysis_run_id=original_run).one().result_summary)
+        records=[r.to_dict() for r in session_records(ride)]
+        fingerprints=[(r.seq,r.record_fingerprint) for r in session_records(ride)]
+        request_before=_raw_decode_request(ride,submission_key='p31-same-attempt')
+        calls=[]
+        def analyzer(request):
+            calls.append(deepcopy(request))
+            if len(calls)==1:raise AnalyzerClientError('Result unconfirmed',code='ANALYZER_TIMEOUT',retryable=True)
+            return self.c.raw_analyzer_response(request,run_id='p31-server')
+        url=f'/api/sessions/{ride.id}/analysis/re-run'
+        with patch.object(AnalyzerClient,'decode_analyze_raw_session',side_effect=analyzer):
+            self.assertEqual(self.c.client.post(url,json={'request_id':'p31-same-attempt'}).status_code,503)
+            self.assertEqual(self.c.client.post(url,json={'request_id':'p31-same-attempt'}).status_code,200)
+            self.assertEqual(self.c.client.post(url,json={'request_id':'p31-same-attempt'}).status_code,200)
+        self.assertEqual(len(calls),2);self.assertEqual(calls,[request_before,request_before])
+        self.assertEqual(self.c.client.post('/api/device/sync/session',json=payload,headers=self.c.headers_a).status_code,200)
+        db.session.refresh(ride)
+        self.assertEqual((ride.capture_status,ride.termination_reason,ride.analysis_run_id),('interrupted','unclean_runtime_shutdown','p31-server'))
+        self.assertEqual([r.to_dict() for r in session_records(ride)],records)
+        self.assertEqual([(r.seq,r.record_fingerprint) for r in session_records(ride)],fingerprints)
+        self.assertEqual(AnalysisResult.query.filter_by(ride_session_id=ride.id).count(),2)
+        self.assertEqual(AnalysisResult.query.filter_by(analysis_run_id=original_run).one().result_summary,original)
+        provenance=AnalysisResult.query.filter_by(analysis_run_id='p31-server').one().result_summary['reanalysis']
+        self.assertEqual(provenance['capture_status'],'interrupted');self.assertEqual(provenance['termination_reason'],'unclean_runtime_shutdown')
+        self.assertTrue(analysis_snapshot(ride)['can_rerun'])
+
+    def test_canonical_fallback_interrupted_stays_supported(self):
+        ride,_=self.interrupted('p31-canonical')
+        for r in session_records(ride):r.raw_hex=None;r.raw_frame=None
+        db.session.commit()
+        self.assertTrue(manual_rerun_state(ride,session_records(ride))['eligible'])
+        with patch.object(AnalyzerClient,'analyze_session',return_value=self.c.pi_analysis(run_id='p31-canonical-server')) as canonical, patch.object(AnalyzerClient,'decode_analyze_raw_session') as raw:
+            self.assertEqual(self.c.client.post(f'/api/sessions/{ride.id}/analysis/re-run',json={'request_id':'canonical'}).status_code,200)
+            canonical.assert_called_once();raw.assert_not_called()
+        self.assertEqual(ride.capture_status,'interrupted')
+
+    def test_interrupted_security_csrf_ownership_and_guest(self):
+        ride,_=self.interrupted('p31-security');url=f'/api/sessions/{ride.id}/analysis/re-run'
+        self.c.app.config['WTF_CSRF_ENABLED']=True
+        with patch.object(AnalyzerClient,'decode_analyze_raw_session') as infer:
+            self.assertEqual(self.c.client.post(url,json={'request_id':'missing-csrf'}).status_code,400)
+            csrf=self.c.client.get('/auth/csrf',base_url='https://localhost').json['csrf_token']
+            with patch.object(AnalyzerClient,'decode_analyze_raw_session',side_effect=lambda r:self.c.raw_analyzer_response(r,run_id='p31-secure')):
+                self.assertEqual(self.c.client.post(url,json={'request_id':'with-csrf'},headers={'X-CSRFToken':csrf,'Referer':'https://localhost/'},base_url='https://localhost').status_code,200)
+            infer.assert_not_called()
+        self.c.app.config['WTF_CSRF_ENABLED']=False
+        self.c.client.post('/auth/logout');self.c.login(self.c.user_b.email)
+        with patch.object(AnalyzerClient,'decode_analyze_raw_session') as infer:
+            self.assertEqual(self.c.client.post(url,json={'request_id':'other-owner'}).status_code,404);infer.assert_not_called()
+        self.c.client.post('/auth/logout')
+        with self.c.client.session_transaction() as session:session.clear();session['demo_mode']=True
+        self.assertEqual(self.c.client.post(url,json={'request_id':'guest'}).status_code,403)
+
+    def test_interrupted_both_locales_no_implicit_analysis_and_separate_status(self):
+        ride,_=self.interrupted('p31-locales')
+        for status in ['completed','failed']:
+            ride.analysis_status=status;db.session.commit()
+            for lang,label,context in [('en','Re-run Harness Analysis','an abrupt ending alone does not establish a component fault'),
+                                       ('vi','Phân tích lại bằng Harness','không đủ để kết luận bộ phận bị hỏng')]:
+                self.c.client.set_cookie('drisafe.language',lang)
+                with patch.object(AnalyzerClient,'decode_analyze_raw_session') as infer:
+                    response=self.c.client.get(f'/sessions/{ride.id}');infer.assert_not_called()
+                html=response.get_data(as_text=True);text=str(Text(html));parser=Actions();parser.feed(html)
+                self.assertIn(label,text);self.assertIn(context,text);self.assertEqual(parser.buttons,[{'details':[],'disabled':False}]);self.assertNotIn('localization-gap',html)
+                self.assertEqual(self.c.client.get(f'/sessions/{ride.id}.json').json['session']['capture_status'],'interrupted')
+
+    def test_terminal_evidence_timeline_and_predictions_are_retained_without_new_cause(self):
+        ride,_=self.interrupted('p31-terminal')
+        evidence=json.loads((Path(__file__).parent/'fixtures/p2_canary_interpretation.json').read_text())
+        evidence['analysis_run_id']='p31-terminal-server'
+        evidence['health_score']=88.0
+        evidence['model_version']='p31-unchanged-test-model'
