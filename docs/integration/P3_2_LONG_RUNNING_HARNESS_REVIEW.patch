+"""Durable bounded manual attempts executed inside existing Gunicorn workers.
+
+A shared persistent directory is authoritative; threads are only executors.
+No RAW/canonical body is copied here. Only explicit manual attempts are read.
+"""
+from contextlib import contextmanager
+import fcntl
+import json
+import os
+from pathlib import Path
+import tempfile
+import threading
+import time
+import uuid
+
+from flask import current_app
+from extensions import db
+from models import AnalysisResult, RideSession
+from services.analysis_submission import manual_rerun_state, _stored_records, submit_session_to_analyzer
+
+ACTIVE = {'queued', 'running'}
+KEYS = {'idle':'harness.idle', 'queued':'harness.queued', 'running':'harness.running',
+        'completed':'harness.completed', 'retryable':'harness.retryable', 'invalid':'harness.invalid',
+        'busy':'harness.busy'}
+
+
+def directory():
+    path = Path(current_app.config.get('HARNESS_STATE_DIR') or Path(current_app.instance_path)/'manual-analysis')
+    path.mkdir(parents=True, exist_ok=True, mode=0o700)
+    return path
+
+
+@contextmanager
+def lock(name, *, blocking=True):
+    with (directory()/name).open('a') as handle:
+        acquired=False
+        try:
+            try:
+                fcntl.flock(handle,fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB));acquired=True
+            except BlockingIOError:
+                pass
+            yield acquired
+        finally:
+            if acquired:fcntl.flock(handle,fcntl.LOCK_UN)
+
+
+def read(pk):
+    try:return json.loads((directory()/f'{int(pk)}.json').read_text())
+    except FileNotFoundError:return None
+
+
+def write(job):
+    # Atomic replace + fsync; a killed process cannot expose half-written state.
+    path=directory()/f"{job['session_pk']}.json"
+    fd,name=tempfile.mkstemp(prefix='.attempt-',dir=path.parent)
+    try:
+        with os.fdopen(fd,'w') as dest:
+            json.dump(job,dest);dest.flush();os.fsync(dest.fileno())
+        os.replace(name,path)
+        parent=os.open(path.parent,os.O_RDONLY)
+        try:os.fsync(parent)
+        finally:os.close(parent)
+    finally:
+        if os.path.exists(name):os.unlink(name)
+
+
+def view(job):
+    if job is None:return {'state':'idle','message_key':KEYS['idle'],'retryable':False}
+    return {key:job[key] for key in ('request_id','state','analysis_run_id','updated_at') if key in job} | {
+        'message_key':KEYS[job['state']], 'retryable':job['state'] in ('retryable','busy'),
+        'retry_after':5 if job['state'] in ACTIVE or job['state']=='busy' else None}
+
+
+def status(ride):
+    job=read(ride.id)
+    # A deleted/reimported numeric PK must not reveal/recover another capture.
+    if job and job['session_id']!=ride.session_id:return view(None)
+    return view(job)
+
+
+def enqueue(ride, request_id=None):
+    if not current_app.config.get('ML_API_BASE_URL'):
+        return {'state':'retryable','request_id':request_id,'message_key':KEYS['retryable'],'retryable':True},503
+    # Reuse the existing durable successful-result identity before queueing.
+    if request_id:
+        for result in AnalysisResult.query.filter_by(ride_session_id=ride.id).all():
+            if ((result.result_summary or {}).get('reanalysis') or {}).get('manual_request_id')==request_id:
+                return {'state':'completed','request_id':request_id,'analysis_run_id':result.analysis_run_id,
+                        'message_key':KEYS['completed'],'retryable':False},200
+    with lock('.queue.lock'):
+        job=read(ride.id)
+        if job and job['session_id']==ride.session_id:
+            if job['state'] in ACTIVE:return view(job),202
+            if job['request_id']==request_id and job['state']=='completed':return view(job),200
+            if job['state']=='retryable' and job['request_id']!=request_id:
+                # An unconfirmed old attempt must be recovered before a new one.
+                return view(job),200
+        state=manual_rerun_state(ride,_stored_records(ride))
+        if not state['eligible']:
+            return {'state':'invalid','message_key':state['message'],'retryable':False},409
+        pending=sum(json.loads(p.read_text())['state'] in ACTIVE for p in directory().glob('*.json'))
+        if pending>=int(current_app.config.get('HARNESS_MAX_PENDING',2)):
+            return {'state':'busy','request_id':request_id,'message_key':KEYS['busy'],'retryable':True,'retry_after':5},429
+        retry=job and job['session_id']==ride.session_id and job['request_id']==request_id
+        job={'session_pk':ride.id,'session_id':ride.session_id,'request_id':request_id or str(uuid.uuid4()),
+             'state':'queued','created_at':job['created_at'] if retry else time.time(),
+             'updated_at':time.time(),'next_try':0,'recover_claim':bool(retry),
+             'previous_run_id':job['previous_run_id'] if retry else ride.analysis_run_id}
+        write(job)
+    return view(job),202
+
+
+def run_one():
+    """One global execution slot across processes; returns immediately if busy."""
+    with lock('.worker.lock',blocking=False) as owned:
+        if not owned:return False
+        with lock('.queue.lock'):
+            jobs=[json.loads(p.read_text()) for p in directory().glob('*.json')]
+            jobs=[j for j in jobs if j['state'] in ACTIVE and j.get('next_try',0)<=time.time()]
+            if not jobs:return False
+            job=min(jobs,key=lambda j:j['created_at'])
+            recovery=job.get('recover_claim',False) or job['state']=='running'
+            job.update(state='running',updated_at=time.time(),recover_claim=True);write(job)
+        try:
+            ride=db.session.get(RideSession,job['session_pk'])
+            if ride is None or ride.session_id!=job['session_id']:
+                result={'state':'ineligible'}
+            else:
+                # Only this durable attempt, under the process-wide file lock,
+                # may reclaim a fresh DB lease after executor/process loss.
+                recovery=recovery and ride.analysis_run_id==job['previous_run_id']
+                result=submit_session_to_analyzer(ride.id,force=True,submission_key=job['request_id'],recover_claim=recovery)
+            if result['state']=='completed':
+                job.update(state='completed',analysis_run_id=result['analysis']['analysis_run_id'])
+            elif result['state'] in ('busy','running'):
+                job.update(state='queued',next_try=time.time()+5)
+            elif result['state']=='ineligible' or not result.get('retryable',False):
+                job.update(state='invalid')
+            else:job.update(state='retryable')
+        except Exception:
+            db.session.rollback()
+            current_app.logger.exception('Manual Harness attempt interrupted: session=%s request=%s',job['session_pk'],job['request_id'])
+            job.update(state='retryable')
+        finally:
+            db.session.remove()
+        with lock('.queue.lock'):
+            current=read(job['session_pk'])
+            if current and current['request_id']==job['request_id']:
+                job['updated_at']=time.time();write(job)
+        return True
+
+
+def init_worker(app):
+    if not app.config.get('HARNESS_ASYNC_ENABLED'):return
+    with app.app_context():directory()
+    if not app.config.get('HARNESS_WORKER_ENABLED',True):return
+    stop=threading.Event()
+    def loop():
+        while not stop.is_set():
+            try:
+                with app.app_context():run_one()
+            except Exception:
+                app.logger.exception('Manual Harness executor unavailable')
+            stop.wait(1)
+    thread=threading.Thread(target=loop,name='manual-harness',daemon=True)
+    thread.start();app.extensions['manual_harness_worker']={'thread':thread,'stop':stop}
