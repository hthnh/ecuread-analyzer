+from copy import deepcopy
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from extensions import db
+from models import AnalysisResult, utc_now
+from integrations.analyzer_client import AnalyzerClient, AnalyzerClientError
+from services.manual_analysis import read, write, run_one, lock
+from tests import test_app as fixtures
+
+
+class ManualWorkerTests(unittest.TestCase):
+    def setUp(self):
+        self.c=fixtures.DashboardTestCase('runTest');self.c.setUp();self.addCleanup(self.c.tearDown)
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+        self.c.app.config.update(HARNESS_ASYNC_ENABLED=True,HARNESS_STATE_DIR=self.tmp.name,
+                                 HARNESS_WORKER_ENABLED=False,HARNESS_CLAIM_LEASE_SECONDS=420,ML_API_BASE_URL='http://analyzer.example')
+        self.c.login();self.ride=self.c.post_pi_v2_session('p32-primary')
+        self.url=f'/api/sessions/{self.ride.id}/analysis/re-run'
+    def post(self,key='same-attempt'):return self.c.client.post(self.url,json={'request_id':key})
+    def status(self):return self.c.client.get(self.url+'/status')
+    def work(self):
+        with self.c.app.app_context():return run_one()
+    def success(self,payload):return self.c.raw_analyzer_response(payload,run_id='p32-server')
+    def test_accepts_promptly_status_only_get_and_same_key_reuses_completed_run(self):
+        old=self.ride.analysis_run_id
+        with patch.object(AnalyzerClient,'decode_analyze_raw_session',side_effect=self.success) as infer:
+            self.assertEqual(self.post().status_code,202);infer.assert_not_called()
+            self.assertEqual(self.post().json['state'],'queued')
+            with patch('services.manual_analysis._stored_records',side_effect=AssertionError('status must be small')):
+                self.assertEqual(self.status().json['state'],'queued')
+            self.assertEqual(self.ride.analysis_run_id,old);self.work()
+            self.assertEqual(self.status().json['state'],'completed');self.assertEqual(self.post().status_code,200)
+            self.assertEqual(infer.call_count,1)
+        self.assertEqual(AnalysisResult.query.filter_by(ride_session_id=self.ride.id).count(),2)
+        self.assertEqual(self.ride.capture_status,'completed')
+    def test_bounded_queue_and_cross_worker_execution_lock(self):
+        self.assertEqual(self.post().status_code,202)
+        second=self.c.post_pi_v2_session('p32-second');third=self.c.post_pi_v2_session('p32-third')
+        self.assertEqual(self.c.client.post(f'/api/sessions/{second.id}/analysis/re-run',json={'request_id':'second'}).status_code,202)
+        self.assertEqual(self.c.client.post(f'/api/sessions/{third.id}/analysis/re-run',json={'request_id':'third'}).status_code,429)
+        self.assertEqual(third.analysis_status,'completed')
+        with lock('.worker.lock'),patch.object(AnalyzerClient,'decode_analyze_raw_session') as infer:
+            self.assertFalse(self.work());infer.assert_not_called()
+    def test_busy_restores_previous_result_and_retries_only_the_same_identity(self):
+        self.post();old=self.ride.analysis_run_id;calls=[]
+        def analyze(p):
+            calls.append(deepcopy(p))
+            if len(calls)==1:raise AnalyzerClientError('private detail',status_code=429,code='RAW_ANALYSIS_BUSY',retryable=True)
+            return self.success(p)
+        with patch.object(AnalyzerClient,'decode_analyze_raw_session',side_effect=analyze):
+            self.work();self.assertEqual(self.status().json['state'],'queued');db.session.refresh(self.ride)
+            self.assertEqual(self.ride.analysis_run_id,old);self.assertEqual(self.ride.analysis_status,'completed')
+            j=read(self.ride.id);j['next_try']=0;write(j);self.work()
+        self.assertEqual(calls[0],calls[1]);self.assertEqual(self.status().json['state'],'completed')
+    def test_retryable_timeout_keeps_attempt_and_previous_result(self):
+        self.post();old=self.ride.analysis_run_id
+        with patch.object(AnalyzerClient,'decode_analyze_raw_session',side_effect=AnalyzerClientError('secret exception',code='ANALYZER_TIMEOUT',retryable=True)):
+            self.work()
+        db.session.refresh(self.ride);self.assertEqual(self.ride.analysis_status,'completed');self.assertEqual(self.ride.analysis_run_id,old)
+        self.assertEqual(self.status().json['state'],'retryable');self.assertNotIn('secret',str(self.status().json))
+        self.assertEqual(self.post('new-independent-key').json['request_id'],'same-attempt')
+        self.assertEqual(self.post().status_code,202)
+        with patch.object(AnalyzerClient,'decode_analyze_raw_session',side_effect=self.success):self.work()
+        self.assertEqual(self.status().json['state'],'completed')
