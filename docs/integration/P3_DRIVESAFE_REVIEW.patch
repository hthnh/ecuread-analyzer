+def manual_rerun_state(ride_session: RideSession, records) -> dict:
+    """Presentation eligibility, independent of the selected result's success.
+
+    The endpoint still validates the complete input; this view never runs ML.
+    """
+    reason = None
+    if ride_session.sync_status != "complete" or ride_session.capture_status != "completed":
+        reason = "rerun.incomplete"
+    elif not records or len(records) != ride_session.record_count:
+        reason = "rerun.missing_records"
+    elif ride_session.source_type not in (PI_SOURCE_TYPE, "esp_raw"):
+        reason = "rerun.unsupported"
+    elif ride_session.source_type == "esp_raw" and ride_session.raw_representation != "legacy29_ff5":
+        reason = "rerun.unsupported"
+    else:
+        # Eligibility needs RAW/timestamp completeness, not uploaded speed JSON.
+        # Avoid deserializing candidate_signals for every row in a page request.
+        raw_complete = all(_record_raw_hex(record) and _evidence_timestamp(ride_session, record) is not None for record in records)
+        raw_complete = raw_complete and all(getattr(ride_session, name) for name in
+                                          ("raw_representation", "ecu_profile_id", "decoder_id", "decoder_version"))
+        if raw_complete and len(records) > 20_000:
+            reason = "rerun.record_limit"
+        elif raw_complete:
+            try:
+                for record in records:
+                    bytes.fromhex(_record_raw_hex(record))
+                    if not math.isfinite(_evidence_timestamp(ride_session, record)):
+                        raise ValueError("nonfinite timestamp")
+            except (TypeError, ValueError):
+                reason = "rerun.invalid_raw"
+        else:
+            canonical_fields = ("rpm", "tps_voltage", "tps_raw", "battery_voltage", "iat_c", "ect_c")
+            canonical_ok = ride_session.source_type == PI_SOURCE_TYPE and all(
+                getattr(ride_session, name) for name in ("ecu_profile_id", "decoder_id", "decoder_version", "telemetry_schema_version")
+            ) and all(
+                _evidence_timestamp(ride_session, record) is not None
+                and all(isinstance(getattr(record, name), (int, float)) and math.isfinite(getattr(record, name)) for name in canonical_fields)
+                for record in records
+            )
+            if not canonical_ok:
+                reason = "rerun.missing_evidence"
+    updated = ride_session.updated_at
+    # SQLite fixtures may return naive UTC datetimes.
+    from datetime import timezone
+    if updated is not None and updated.tzinfo is None:
+        updated = updated.replace(tzinfo=timezone.utc)
+    processing = ride_session.analysis_status in ("pending", "submitted") and (
+        updated is None or updated >= utc_now() - timedelta(seconds=180)
+    )
+    return {"eligible": reason is None, "processing": processing,
+            "message": reason or ("rerun.processing" if processing else "rerun.ready")}
+
